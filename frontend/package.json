{
  "name": "recreated-online-coding-task-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild": "node scripts/write-env.mjs",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:en": "ng build --configuration production",
    "build:nl": "ng build --configuration nl",
    "extract-i18n": "ng extract-i18n --format xlf2 --output-path src/locale",
    "test": "ng test --watch=false"
  },
  "dependencies": {
    "@angular/animations": "21.2.7",
    "@angular/common": "21.2.7",
    "@angular/compiler": "21.2.7",
    "@angular/core": "21.2.7",
    "@angular/forms": "21.2.7",
    "@angular/localize": "21.2.7",
    "@angular/platform-browser": "21.2.7",
    "@angular/router": "21.2.7",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.7",
    "@angular/cli": "21.2.7",
    "@angular/compiler-cli": "21.2.7",
    "@types/jasmine": "^5.1.5",
    "jasmine-core": "^5.2.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "typescript": "~5.9.0"
  }
}
